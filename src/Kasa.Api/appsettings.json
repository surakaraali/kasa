{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Quartz": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "kasa",
    "Audience": "kasa-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Redis": {
    "KeyPrefix": "kasa:"
  },
  "LoginRateLimit": {
    "AttemptsPerMinute": 10
  },
  "Mongo": {
    "Database": "kasa",
    "RawResponseDays": 90
  },
  "Banks": {
    "Timeout": "00:00:10",
    "AcikBank": {
      "ClientId": "kasa"
    },
    "KlasikBank": {}
  },
  "BankSync": {
    "Schedule": "0 0/15 * * * ?"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "RetryDelay": "00:00:10"
  },
  "Outbox": {
    "PollInterval": "00:00:01",
    "BatchSize": 50
  },
  "Assistant": {
    "Model": "claude-opus-5-5",
    "Effort": "low",
    "MaxTokens": 8000,
    "MaxToolRounds": 6,
    "QuestionsPerHour": 30
  }
}
