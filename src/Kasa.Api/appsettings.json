{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "kasa",
    "Audience": "kasa-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Redis": {
    "KeyPrefix": "kasa:"
  },
  "LoginRateLimit": {
    "AttemptsPerMinute": 10
  }
}
